includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 7

    excludePaths:
        - database/seeders/ShieldSeeder.php
        - app/Settings/VolunteerSettings.php

    paths:
        - app
        - bootstrap
        - database
        - routes
